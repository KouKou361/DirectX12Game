!131 = !{!"Lib\5CShader\5CMeshletMS.hlsl", !"//*********************************************************\0D\0A//\0D\0A// Copyright (c) Microsoft. All rights reserved.\0D\0A// This code is licensed under the MIT License (MIT).\0D\0A// THIS CODE IS PROVIDED *AS IS* WITHOUT WARRANTY OF\0D\0A// ANY KIND, EITHER EXPRESS OR IMPLIED, INCLUDING ANY\0D\0A// IMPLIED WARRANTIES OF FITNESS FOR A PARTICULAR\0D\0A// PURPOSE, MERCHANTABILITY, OR NON-INFRINGEMENT.\0D\0A//\0D\0A//*********************************************************\0D\0A\0D\0A#define ROOT_SIG \22CBV(b0), \5C\0D\0A                  RootConstants(b1, num32bitconstants=2), \5C\0D\0A                  SRV(t0), \5C\0D\0A                  SRV(t1), \5C\0D\0A                  SRV(t2), \5C\0D\0A                  SRV(t3)\22\0D\0A\0D\0Astruct Constants\0D\0A{\0D\0A    float4x4 World;\0D\0A    float4x4 WorldView;\0D\0A    float4x4 WorldViewProj;\0D\0A    uint     DrawMeshlets;\0D\0A};\0D\0A\0D\0Astruct MeshInfo\0D\0A{\0D\0A    uint IndexBytes;\0D\0A    uint MeshletOffset;\0D\0A};\0D\0A\0D\0Astruct Vertex\0D\0A{\0D\0A    float3 Position;\0D\0A    float3 Normal;\0D\0A};\0D\0A\0D\0Astruct VertexOut\0D\0A{\0D\0A    float4 PositionHS   : SV_Position;\0D\0A    float3 PositionVS   : POSITION0;\0D\0A    float3 Normal       : NORMAL0;\0D\0A    uint   MeshletIndex : COLOR0;\0D\0A};\0D\0A\0D\0Astruct Meshlet\0D\0A{\0D\0A    uint VertCount;\0D\0A    uint VertOffset;\0D\0A    uint PrimCount;\0D\0A    uint PrimOffset;\0D\0A};\0D\0A\0D\0AConstantBuffer<Constants> Globals             : register(b0);\0D\0AConstantBuffer<MeshInfo>  meshInfo            : register(b1);\0D\0A\0D\0AStructuredBuffer<Vertex>  Vertices            : register(t0);\0D\0AStructuredBuffer<Meshlet> Meshlets            : register(t1);\0D\0AByteAddressBuffer         UniqueVertexIndices : register(t2);\0D\0AStructuredBuffer<uint>    PrimitiveIndices    : register(t3);\0D\0A\0D\0A\0D\0A/////\0D\0A// Data Loaders\0D\0A\0D\0Auint3 UnpackPrimitive(uint primitive)\0D\0A{\0D\0A    // Unpacks a 10 bits per index triangle from a 32-bit uint.\0D\0A    return uint3(primitive & 0x3FF, (primitive >> 10) & 0x3FF, (primitive >> 20) & 0x3FF);\0D\0A}\0D\0A\0D\0Auint3 GetPrimitive(Meshlet m, uint index)\0D\0A{\0D\0A    return UnpackPrimitive(PrimitiveIndices[m.PrimOffset + index]);\0D\0A}\0D\0A\0D\0Auint GetVertexIndex(Meshlet m, uint localIndex)\0D\0A{\0D\0A    localIndex = m.VertOffset + localIndex;\0D\0A\0D\0A    if (meshInfo.IndexBytes == 4) // 32-bit Vertex Indices\0D\0A    {\0D\0A        return UniqueVertexIndices.Load(localIndex * 4);\0D\0A    }\0D\0A    else // 16-bit Vertex Indices\0D\0A    {\0D\0A        // Byte address must be 4-byte aligned.\0D\0A        uint wordOffset = (localIndex & 0x1);\0D\0A        uint byteOffset = (localIndex / 2) * 4;\0D\0A\0D\0A        // Grab the pair of 16-bit indices, shift & mask off proper 16-bits.\0D\0A        uint indexPair = UniqueVertexIndices.Load(byteOffset);\0D\0A        uint index = (indexPair >> (wordOffset * 16)) & 0xffff;\0D\0A\0D\0A        return index;\0D\0A    }\0D\0A}\0D\0A\0D\0AVertexOut GetVertexAttributes(uint meshletIndex, uint vertexIndex)\0D\0A{\0D\0A    Vertex v = Vertices[vertexIndex];\0D\0A\0D\0A    VertexOut vout;\0D\0A    vout.PositionVS = mul(float4(v.Position, 1), Globals.WorldView).xyz;\0D\0A    vout.PositionHS = mul(float4(v.Position, 1), Globals.WorldViewProj);\0D\0A    vout.Normal = mul(float4(v.Normal, 0), Globals.World).xyz;\0D\0A    vout.MeshletIndex = meshletIndex;\0D\0A\0D\0A    return vout;\0D\0A}\0D\0A\0D\0A\0D\0A[RootSignature(ROOT_SIG)]\0D\0A[NumThreads(128, 1, 1)]\0D\0A[OutputTopology(\22triangle\22)]\0D\0Avoid main(\0D\0A    uint gtid : SV_GroupThreadID,\0D\0A    uint gid : SV_GroupID,\0D\0A    out indices uint3 tris[126],\0D\0A    out vertices VertexOut verts[64]\0D\0A)\0D\0A{\0D\0A    Meshlet m = Meshlets[meshInfo.MeshletOffset + gid];\0D\0A\0D\0A    SetMeshOutputCounts(m.VertCount, m.PrimCount);\0D\0A\0D\0A    if (gtid < m.PrimCount)\0D\0A    {\0D\0A        tris[gtid] = GetPrimitive(m, gtid);\0D\0A    }\0D\0A\0D\0A    if (gtid < m.VertCount)\0D\0A    {\0D\0A        uint vertexIndex = GetVertexIndex(m, gtid);\0D\0A        verts[gtid] = GetVertexAttributes(gid, vertexIndex);\0D\0A    }\0D\0A}\0D\0A"}
